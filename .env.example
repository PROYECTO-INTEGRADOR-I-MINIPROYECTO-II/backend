PORT=3000
CORS_ORIGIN=http://localhost:5173
# JSON de la service account en base64: base64 -w0 service-account.json
FIREBASE_SERVICE_ACCOUNT=
# URL del servicio de tiempo real (solo la API la usa para avisarle al eliminar cuentas)
REALTIME_URL=http://localhost:3001
# Secreto compartido entre la API y el servicio de tiempo real (ej: openssl rand -hex 32)
INTERNO_TOKEN=

# Solo para desarrollo/pruebas con emuladores (npm run test:int ya los define). Con ellos no hace falta
# FIREBASE_SERVICE_ACCOUNT y el proyecto es demo-synk: nunca toca el Firebase real.
# FIRESTORE_EMULATOR_HOST=
# FIREBASE_AUTH_EMULATOR_HOST=
# GCLOUD_PROJECT=
